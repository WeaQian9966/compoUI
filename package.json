{
    "name": "compo-ui",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/compo-ui.umd.cjs",
    "module": "./dist/compo-ui.es.js",
